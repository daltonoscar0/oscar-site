  "causes": {
    "one_abbrev_per_span": {
      "description": "At most one abbreviation inside a span is expanded. A span is handed to one class's grammar, and that grammar rewrites the field it was written for; a second abbreviation in the same span has no second grammar to claim it.",
      "n": 8
    },
    "house_number_as_quantity": {
      "description": "A house number is read as a quantity rather than as digits in pairs. The grouped reading exists -- PO Box 1234 is 'twelve thirty-four' -- but ADDRESS does not ask for it for the number before the street.",
      "n": 3
    },
    "unspoken_character_glued_on": {
      "description": "A character with no spoken form that sits against a classified span is copied through verbatim and concatenated to the word beside it, with no space: a sign, or a letter on a house number.",
      "n": 2
    },
    "keyword_before_digits": {
      "description": "A keyword in front of a number ('dial', 'extension', 'PIN') is evidence no grammar reads, because a grammar cannot see outside its own span. Declined by design, not missing.",
      "n": 3
    },
    "regnal_numeral": {
      "description": "A Roman numeral behind a name is offered as a cardinal, not an ordinal, because 'World War II' is the same shape and no weight separates them. Declined by design.",
      "n": 2
    },
    "two_digit_year": {
      "description": "DATE reads four-digit years only, so a two-digit one leaves the prefix to another class.",
      "n": 1
    },
    "month_abbrev_without_year": {
      "description": "An abbreviated month is expanded inside a full date and left alone without one. 'Sept 11, 2001' works; 'Dec 25' and 'Aug 1990' do not, so DATE wants a year or a comma before it will claim the month.",
      "n": 3
    },
    "measure_claimed_by_phone": {
      "description": "A short digit run against capital letters is claimed by PHONE before MEASURE gets to it: '797 MB' tags as a phone fragment and comes out 'seven nine seven, M B'. A weighting problem between two classes, not a missing grammar.",
      "n": 1
    },
    "bare_capitals_not_spelled": {
      "description": "LETTERS spells dotted initialisms and not bare capital runs, because its table is corpus-derived and adding the short ones would break 'IN', 'OR', 'ME' and 'HI' as words. So 'PO' stays 'PO'. Declined by design, with a cost.",
      "n": 1
    },
    "single_initial_name": {
      "description": "NAME requires two initials, because one initial in front of a capitalised word absorbs it for free and cost '$5.4 M. Central Park' its magnitude. Declined by design.",
      "n": 1
    },
    "missing_from_table": {
      "description": "The abbreviation or unit is simply not in the table that would expand it. A coverage gap, not a design decision.",
      "n": 7
    }
  }
}
